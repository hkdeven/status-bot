{
  "github": {
    "repos": [
      "your-org/your-repo",
      "your-org/another-repo"
    ]
  },
  "outlook": {
    "yourAddresses": [
      "you@example.com"
    ],
    "maxMessages": 100,
    "suppressCoveredNotifications": true,
    "ignoreRules": [
      {
        "label": "help desk",
        "from": "zohodesk\\.com|helpdesk@|servicedesk@"
      },
      {
        "label": "incidents",
        "from": "no-reply@",
        "subject": "incident"
      },
      {
        "label": "field service",
        "from": "no-reply@",
        "subject": "field service"
      },
      {
        "label": "RFI",
        "subject": "\\bRFI\\b"
      },
      {
        "label": "shipping",
        "subject": "shipment|tracking number|freight|bill of lading|out for delivery|carrier|\\bBOL\\b"
      }
    ]
  },
  "trello": {
    "boards": "all",
    "dueSoonDays": 3,
    "excludeBoards": [
      "A Board You Never Read"
    ]
  },
  "zoho": {
    "projects": "all",
    "excludeProjects": [
      "Some Noisy Template Project"
    ],
    "watchFields": [
      "Expected Release Date",
      "tags",
      "status"
    ],
    "sprintTagPattern": "SPRINT",
    "awaitingDeploymentStatus": "ready for release"
  }
}