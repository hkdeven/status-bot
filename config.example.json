{
  "github": {
    "repos": [
      "your-org/your-repo",
      "your-org/another-repo"
    ]
  },
  "outlook": {
    "yourAddresses": [
      "you@example.com"
    ],
    "maxMessages": 100,
    "suppressCoveredNotifications": true,
    "helpdeskSenders": [
      "zohodesk\\.com",
      "helpdesk@",
      "servicedesk@"
    ]
  },
  "trello": {
    "boards": "all",
    "dueSoonDays": 3,
    "excludeBoards": [
      "A Board You Never Read"
    ]
  },
  "zoho": {
    "projects": "all",
    "excludeProjects": [
      "Some Noisy Template Project"
    ],
    "watchFields": [
      "Expected Release Date",
      "tags",
      "status"
    ],
    "sprintTagPattern": "SPRINT",
    "awaitingDeploymentStatus": "ready for release"
  }
}